{
  "openapi": "3.0.0",
  "info": {
    "title": "Kangwon National University Scholarship & Contest Recommendation API",
    "description": "Front → FastAPI Back → DB 구조의 장학 및 공모전 추천 서비스 API 명세서입니다.",
    "version": "2.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "FastAPI Local Server"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/auth/signup": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "회원가입",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "회원가입 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "description": "잘못된 요청 (이메일 중복 등)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "로그인",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "로그인 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "401": {
            "description": "인증 실패",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/users/me": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "내 정보 조회",
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "description": "인증 필요",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Users"
        ],
        "summary": "내 프로필 수정",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "수정 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "잘못된 요청",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "인증 필요",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/scholarships": {
      "get": {
        "tags": [
          "Scholarships"
        ],
        "summary": "장학금 공고 목록 조회",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            },
            "description": "페이지 번호"
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 100
            },
            "description": "페이지 당 항목 수"
          },
          {
            "name": "keyword",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "검색 키워드 (제목/주관기관)"
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "성적우수",
                "생활지원",
                "근로",
                "외부",
                "기타"
              ]
            },
            "description": "장학금 카테고리"
          },
          {
            "name": "grade",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            },
            "description": "지원 가능 학년 필터"
          },
          {
            "name": "department",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "지원 가능 학과 필터"
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "deadline_asc",
                "deadline_desc",
                "latest"
              ],
              "default": "deadline_asc"
            },
            "description": "정렬 기준"
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total": {
                      "type": "integer",
                      "example": 124
                    },
                    "page": {
                      "type": "integer",
                      "example": 1
                    },
                    "size": {
                      "type": "integer",
                      "example": 20
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ScholarshipSummary"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/scholarships/{scholarship_id}": {
      "get": {
        "tags": [
          "Scholarships"
        ],
        "summary": "장학금 공고 상세 조회",
        "parameters": [
          {
            "name": "scholarship_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "장학금 ID"
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScholarshipDetail"
                }
              }
            }
          },
          "404": {
            "description": "해당 장학금을 찾을 수 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/contests": {
      "get": {
        "tags": [
          "Contests"
        ],
        "summary": "공모전/대회 목록 조회",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "keyword",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "검색 키워드 (제목/주최기관)"
          },
          {
            "name": "field",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "IT",
                "디자인",
                "마케팅",
                "학술",
                "창업",
                "예술",
                "기타"
              ]
            },
            "description": "공모전 분야"
          },
          {
            "name": "host_type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "교내",
                "교외",
                "기업",
                "정부",
                "기타"
              ]
            },
            "description": "주최 기관 유형"
          },
          {
            "name": "participation_type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "개인",
                "팀",
                "개인/팀"
              ]
            },
            "description": "참가 형태"
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "deadline_asc",
                "deadline_desc",
                "prize_desc",
                "latest"
              ],
              "default": "deadline_asc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total": {
                      "type": "integer"
                    },
                    "page": {
                      "type": "integer"
                    },
                    "size": {
                      "type": "integer"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ContestSummary"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/contests/{contest_id}": {
      "get": {
        "tags": [
          "Contests"
        ],
        "summary": "공모전/대회 상세 조회",
        "parameters": [
          {
            "name": "contest_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContestDetail"
                }
              }
            }
          },
          "404": {
            "description": "해당 공모전을 찾을 수 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/recommendations": {
      "get": {
        "tags": [
          "Recommendations"
        ],
        "summary": "맞춤 추천 목록 조회",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "scholarship",
                "contest"
              ]
            },
            "description": "추천 대상 종류"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10,
              "minimum": 1,
              "maximum": 50
            },
            "description": "추천 개수"
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "scholarship",
                        "contest"
                      ]
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/RecommendationItem"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "인증 필요",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/notifications": {
      "get": {
        "tags": [
          "Notifications"
        ],
        "summary": "알림 목록 조회",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "is_read",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "읽음 여부 필터 (생략 시 전체)"
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total": {
                      "type": "integer"
                    },
                    "unread_count": {
                      "type": "integer"
                    },
                    "page": {
                      "type": "integer"
                    },
                    "size": {
                      "type": "integer"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Notification"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "인증 필요",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/notifications/{notification_id}/read": {
      "patch": {
        "tags": [
          "Notifications"
        ],
        "summary": "알림 읽음 처리",
        "parameters": [
          {
            "name": "notification_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "읽음 처리 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Notification"
                }
              }
            }
          },
          "401": {
            "description": "인증 필요",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "알림을 찾을 수 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "SignupRequest": {
        "type": "object",
        "required": [
          "email",
          "password",
          "name",
          "student_id",
          "college",
          "department",
          "grade"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "student@kangwon.ac.kr"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 8,
            "example": "Passw0rd!"
          },
          "name": {
            "type": "string",
            "example": "홍길동"
          },
          "student_id": {
            "type": "string",
            "example": "202012345"
          },
          "college": {
            "type": "string",
            "example": "IT대학",
            "description": "단과대학"
          },
          "department": {
            "type": "string",
            "example": "컴퓨터공학과"
          },
          "grade": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6,
            "example": 3
          },
          "interests": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "IT",
              "디자인",
              "창업"
            ],
            "description": "관심 분야 (다중 선택)"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "example": "eyJhbGciOi..."
          },
          "token_type": {
            "type": "string",
            "example": "bearer"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": "string",
            "example": "홍길동"
          },
          "student_id": {
            "type": "string",
            "example": "202012345"
          },
          "college": {
            "type": "string",
            "example": "IT대학"
          },
          "department": {
            "type": "string",
            "example": "컴퓨터공학과"
          },
          "grade": {
            "type": "integer",
            "example": 3
          },
          "interests": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "IT",
              "창업"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UserUpdateRequest": {
        "type": "object",
        "description": "수정할 필드만 포함 (부분 업데이트 가능)",
        "properties": {
          "name": {
            "type": "string"
          },
          "college": {
            "type": "string"
          },
          "department": {
            "type": "string"
          },
          "grade": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "interests": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "current_password": {
            "type": "string",
            "format": "password",
            "description": "비밀번호 변경 시 필요"
          },
          "new_password": {
            "type": "string",
            "format": "password",
            "minLength": 8,
            "description": "비밀번호 변경 시 사용"
          }
        }
      },
      "ScholarshipSummary": {
        "type": "object",
        "description": "장학금 목록 카드용 요약 정보",
        "properties": {
          "id": {
            "type": "integer",
            "example": 101
          },
          "title": {
            "type": "string",
            "example": "2026학년도 1학기 성적우수 장학금"
          },
          "organization": {
            "type": "string",
            "example": "강원대학교 학생처"
          },
          "category": {
            "type": "string",
            "enum": [
              "성적우수",
              "생활지원",
              "근로",
              "외부",
              "기타"
            ]
          },
          "amount": {
            "type": "integer",
            "example": 1500000,
            "description": "지원 금액(원)"
          },
          "deadline": {
            "type": "string",
            "format": "date",
            "example": "2026-06-30"
          },
          "d_day": {
            "type": "integer",
            "example": 35,
            "description": "마감까지 남은 일수"
          },
          "target_grades": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "example": [
              2,
              3,
              4
            ]
          },
          "target_departments": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "컴퓨터공학과",
              "전자공학과"
            ],
            "description": "비어있으면 전체 학과 대상"
          }
        }
      },
      "ScholarshipDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ScholarshipSummary"
          },
          {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "example": "직전 학기 성적 3.5 이상..."
              },
              "eligibility": {
                "type": "string",
                "example": "재학생 중 직전 학기 12학점 이상 이수자"
              },
              "recruit_count": {
                "type": "integer",
                "example": 30,
                "description": "모집 인원"
              },
              "application_start": {
                "type": "string",
                "format": "date",
                "example": "2026-05-15"
              },
              "application_end": {
                "type": "string",
                "format": "date",
                "example": "2026-06-30"
              },
              "required_documents": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "example": [
                  "신청서",
