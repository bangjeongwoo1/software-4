{
  "openapi": "3.0.0",
  "info": {
    "title": "Kangwon National University Scholarship & Contest Recommendation API",
    "description": "강원대학교 장학 및 경진대회/공모전 정보 추천 서비스의 Supabase REST & Auth API 명세서입니다. `software-4-frontend` 소스코드(Login.jsx, Signup.jsx, MyPage.jsx, itemsApi.js) 및 SQL 스키마를 기반으로 작성되었습니다.",
    "version": "1.1.0"
  },
  "servers": [
    {
      "url": "https://{project-id}.supabase.co",
      "description": "Supabase API Server",
      "variables": {
        "project-id": {
          "default": "your-supabase-project",
          "description": "Supabase 프로젝트 고유 식별자"
        }
      }
    }
  ],
  "security": [
    {
      "apiKeyHeader": []
    },
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/auth/v1/signup": {
      "post": {
        "tags": ["Authentication"],
        "summary": "회원가입",
        "description": "학번을 이메일 형식(`{student_id}@student.kangwon.ac.kr`)으로 변환하여 Supabase Auth에 회원가입합니다. 학번은 9자리 숫자여야 합니다. (Signup.jsx 참고)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthSignUpRequest"
              },
              "example": {
                "email": "202113575@student.kangwon.ac.kr",
                "password": "password123"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "회원가입 성공 (이메일 확인 대기 상태일 수 있음)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "description": "잘못된 요청 또는 이미 가입된 학번 (`User already registered` 메시지 포함)"
          }
        }
      }
    },
    "/auth/v1/token": {
      "post": {
        "tags": ["Authentication"],
        "summary": "로그인 및 JWT 토큰 발급",
        "description": "학번 이메일과 비밀번호로 인증하고 JWT 액세스 토큰을 발급받습니다. (Login.jsx의 `signInWithPassword` 참고)",
        "parameters": [
          {
            "name": "grant_type",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["password"]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthSignInRequest"
              },
              "example": {
                "email": "202113575@student.kangwon.ac.kr",
                "password": "password123"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "로그인 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "description": "아이디 또는 비밀번호 오류"
          }
        }
      }
    },
    "/auth/v1/logout": {
      "post": {
        "tags": ["Authentication"],
        "summary": "로그아웃",
        "description": "현재 세션을 만료시키고 로그아웃합니다.",
        "responses": {
          "204": {
            "description": "로그아웃 완료"
          },
          "401": {
            "description": "인증 토큰 없음 또는 만료"
          }
        }
      }
    },
    "/auth/v1/user": {
      "get": {
        "tags": ["Authentication"],
        "summary": "현재 로그인 사용자 정보 조회",
        "description": "JWT 토큰 기반으로 로그인 중인 사용자 정보를 반환합니다. MyPage.jsx에서 `supabase.auth.getUser()`로 호출되며, 반환된 `email`에서 `@` 앞 부분을 `student_id`로 사용합니다.",
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid",
                      "description": "Supabase Auth 내부 사용자 UUID"
                    },
                    "email": {
                      "type": "string",
                      "format": "email",
                      "example": "202113575@student.kangwon.ac.kr"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "인증 토큰 없음 또는 만료"
          }
        }
      }
    },
    "/rest/v1/user_account": {
      "post": {
        "tags": ["User Accounts"],
        "summary": "사용자 계정 매핑 레코드 추가",
        "description": "Supabase Auth 회원가입 직후 `public.user_account` 테이블에 학번 레코드를 생성합니다. 비밀번호는 Auth가 관리하므로 `password_hash`에는 더미 값을 삽입합니다. (Signup.jsx 참고)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["student_id", "password_hash"],
                  "properties": {
                    "student_id": {
                      "type": "string",
                      "description": "9자리 학번",
                      "example": "202113575"
                    },
                    "password_hash": {
                      "type": "string",
                      "default": "[SUPABASE_AUTH_MANAGED]",
                      "description": "비밀번호 더미 해시값 (Supabase Auth가 실제 비밀번호 관리)"
                    }
                  }
                }
              },
              "example": [
                {
                  "student_id": "202113575",
                  "password_hash": "[SUPABASE_AUTH_MANAGED]"
                }
              ]
            }
          }
        },
        "responses": {
          "201": {
            "description": "생성 성공"
          },
          "409": {
            "description": "이미 존재하는 학번 (unique constraint 위반, 코드에서 `23505` 에러코드로 무시 처리)"
          }
        }
      }
    },
    "/rest/v1/user_profile": {
      "get": {
        "tags": ["User Profiles"],
        "summary": "사용자 프로필 단건 조회",
        "description": "학번 조건으로 단일 프로필 레코드를 가져옵니다. MyPage.jsx에서 `.select('*').eq('student_id', sid).single()` 형태로 호출됩니다.",
        "parameters": [
          {
            "name": "student_id",
            "in": "query",
            "required": true,
            "description": "조회할 학생의 학번 (PostgREST 필터 형식, 예: `eq.202113575`)",
            "schema": {
              "type": "string",
              "example": "eq.202113575"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "프로필 조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfile"
                }
              }
            }
          },
          "401": {
            "description": "인증 토큰 없음 또는 만료"
          }
        }
      },
      "post": {
        "tags": ["User Profiles"],
        "summary": "사용자 프로필 저장 (Upsert)",
        "description": "사용자의 프로필 정보를 등록하거나 갱신(Upsert)합니다. MyPage.jsx에서 `supabase.from('user_profile').upsert({...})` 형태로 호출됩니다.",
        "parameters": [
          {
            "name": "Prefer",
            "in": "header",
            "required": false,
            "description": "Upsert 처리를 위한 Supabase 헤더",
            "schema": {
              "type": "string",
              "default": "resolution=merge-duplicates"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserProfile"
              },
              "example": {
                "student_id": "202113575",
                "name": "홍길동",
                "department": "소프트웨어학과",
                "grade": "3학년",
                "gpa_prev": 3.78,
                "email": "hong@example.com",
                "phone": "010-1234-5678",
                "campus": "춘천",
                "student_type": "재학생"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "저장 성공"
          },
          "401": {
            "description": "인증 토큰 없음 또는 만료"
          }
        }
      }
    },
    "/rest/v1/user_interest": {
      "get": {
        "tags": ["User Interests"],
        "summary": "사용자 관심 분야 목록 조회",
        "description": "특정 학생의 관심 분야 목록을 가져옵니다. MyPage.jsx에서 `.select('interest_name').eq('student_id', sid)` 형태로 호출됩니다.",
        "parameters": [
          {
            "name": "student_id",
            "in": "query",
            "required": true,
            "description": "학번 조건 (예: `eq.202113575`)",
            "schema": {
              "type": "string",
              "example": "eq.202113575"
            }
          },
          {
            "name": "select",
            "in": "query",
            "required": false,
            "description": "반환할 컬럼 지정 (예: `interest_name`)",
            "schema": {
              "type": "string",
              "default": "interest_name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserInterest"
                  }
                }
              }
            }
          },
          "401": {
            "description": "인증 토큰 없음 또는 만료"
          }
        }
      },
      "post": {
        "tags": ["User Interests"],
        "summary": "사용자 관심 분야 일괄 추가",
        "description": "학생의 관심 분야 리스트를 등록합니다. 저장 전 DELETE로 기존 데이터를 모두 삭제한 뒤 insert합니다. (MyPage.jsx 참고)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/UserInterest"
                }
              },
              "example": [
                { "student_id": "202113575", "interest_name": "개발" },
                { "student_id": "202113575", "interest_name": "AI" }
              ]
            }
          }
        },
        "responses": {
          "201": {
            "description": "등록 성공"
          },
          "401": {
            "description": "인증 토큰 없음 또는 만료"
          }
        }
      },
      "delete": {
        "tags": ["User Interests"],
        "summary": "사용자 관심 분야 전체 삭제",
        "description": "저장 시 덮어쓰기를 위해 특정 학생의 모든 관심 분야를 삭제합니다. POST 전에 항상 먼저 호출됩니다. (MyPage.jsx 참고)",
        "parameters": [
          {
            "name": "student_id",
            "in": "query",
            "required": true,
            "description": "대상 학번 조건 (예: `eq.202113575`)",
            "schema": {
              "type": "string",
              "example": "eq.202113575"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "삭제 성공"
          },
          "401": {
            "description": "인증 토큰 없음 또는 만료"
          }
        }
      }
    },
    "/rest/v1/user_competition": {
      "get": {
        "tags": ["User Competitions"],
        "summary": "사용자 대회 참여 이력 조회",
        "description": "학생의 대회/공모전 경력을 참여일 최신순으로 가져옵니다. MyPage.jsx에서 `.select('*').eq('student_id', sid).order('participated_at', { ascending: false })` 형태로 호출됩니다.",
        "parameters": [
          {
            "name": "student_id",
            "in": "query",
            "required": true,
            "description": "학번 조건 (예: `eq.202113575`)",
            "schema": {
              "type": "string",
              "example": "eq.202113575"
            }
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "description": "정렬 방식",
            "schema": {
              "type": "string",
              "default": "participated_at.desc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserCompetitionResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "인증 토큰 없음 또는 만료"
          }
        }
      },
      "post": {
        "tags": ["User Competitions"],
        "summary": "사용자 대회 참여 이력 일괄 추가",
        "description": "학생의 대회 참여 이력을 여러 건 한 번에 등록합니다. 저장 전 DELETE로 기존 이력을 모두 삭제한 뒤 insert합니다. `title`과 `date` 모두 있는 항목만 전송합니다. (MyPage.jsx 참고)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/UserCompetitionRequest"
                }
              },
              "example": [
                {
                  "student_id": "202113575",
                  "competition_name": "교내 알고리즘 경진대회",
                  "participated_at": "2025-11-08",
                  "result": "장려상"
                }
              ]
            }
          }
        },
        "responses": {
          "201": {
            "description": "등록 성공"
          },
          "401": {
            "description": "인증 토큰 없음 또는 만료"
          }
        }
      },
      "delete": {
        "tags": ["User Competitions"],
        "summary": "사용자 대회 참여 이력 전체 삭제",
        "description": "저장 시 덮어쓰기를 위해 특정 학생의 모든 대회 참여 이력을 삭제합니다. POST 전에 항상 먼저 호출됩니다. (MyPage.jsx 참고)",
        "parameters": [
          {
            "name": "student_id",
            "in": "query",
            "required": true,
            "description": "대상 학번 조건 (예: `eq.202113575`)",
            "schema": {
              "type": "string",
              "example": "eq.202113575"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "삭제 성공"
          },
          "401": {
            "description": "인증 토큰 없음 또는 만료"
          }
        }
      }
    },
    "/rest/v1/scholarship": {
      "get": {
        "tags": ["Scholarships"],
        "summary": "전체 장학금 공고 목록 조회 (관계 테이블 조인 포함)",
        "description": "장학금 메인 테이블과 `customized_detail_1`, `customized_detail_2`, `notice_detail_1`, `notice_detail_2`, `notice_llm` 관계 테이블을 조인하여 조회합니다. `itemsApi.js`의 `fetchItems()` 참고.",
        "parameters": [
          {
            "name": "select",
            "in": "query",
            "required": true,
            "description": "PostgREST 조인 쿼리 (itemsApi.js의 실제 쿼리 참고)",
            "schema": {
              "type": "string",
              "example": "scholarship_id,source_type,title,detail_url,status,customized_detail_1(detail_url,title,scholarship_type,benefit_type,summary),customized_detail_2(title,summary,campus_text,...),notice_detail_1(detail_url,is_notice,campus_text,title,author,registered_at,view_count),notice_detail_2(title,campus_text,author,contact_phone,raw_text,attachment_file_url,attachment_file_type,image_file_url),notice_llm(notice_title,summary,amount_text,department_text,grade_text,grade_min,grade_max,gpa_min,application_start_date,application_close_date)"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Scholarship"
                  }
                }
              }
            }
          },
          "401": {
            "description": "인증 토큰 없음 또는 만료"
          }
        }
      }
    },
    "/rest/v1/contest": {
      "get": {
        "tags": ["Contests"],
        "summary": "전체 공모전/대회 목록 조회 (관계 테이블 조인 포함)",
        "description": "공모전 메인 테이블과 `contest_detail_1`, `contest_detail_2` 관계 테이블을 조인하여 조회합니다. `itemsApi.js`의 `fetchItems()` 참고.",
        "parameters": [
          {
            "name": "select",
            "in": "query",
            "required": true,
            "description": "PostgREST 조인 쿼리 (itemsApi.js의 실제 쿼리 참고)",
            "schema": {
              "type": "string",
              "example": "contest_id,title,detail_url,status,contest_detail_1(detail_url,title,host,target_text,reception_start,reception_end,review_start,review_end,announcement_date,d_day),contest_detail_2(host_organization,main_field,target_text,reception_period_text,review_period_text,contest_region,award_text,homepage_url,application_method,application_url,participation_fee,detail_text)"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Contest"
                  }
                }
              }
            }
          },
          "401": {
            "description": "인증 토큰 없음 또는 만료"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "apikey",
        "description": "Supabase 익명 키(`VITE_SUPABASE_KEY`) — 모든 요청에 필수"
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "로그인 후 발급된 사용자 JWT 액세스 토큰 — 인증이 필요한 엔드포인트에 필수"
      }
    },
    "schemas": {
      "AuthSignUpRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "학번을 이메일로 변환한 값 (`{9자리학번}@student.kangwon.ac.kr`)"
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "description": "비밀번호 (최소 6자)"
          }
        }
      },
      "AuthSignInRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "학번을 이메일로 변환한 값"
          },
          "password": {
            "type": "string",
            "description": "비밀번호"
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "description": "JWT 액세스 토큰"
          },
          "token_type": {
            "type": "string",
            "default": "bearer"
          },
          "expires_in": {
            "type": "integer",
